{
  "name": "tensa-zangetsu-soul-altar-defense",
  "version": "1.1.0",
  "description": "Desktop web arcade slasher game styled after Realm of the Mad God pixel art and Bleach anime lore. Slice incoming Hollow swarms with mouse blade kinematics and defend the Soul Altar.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/test-engine.js test/test-combat.js test/test-e2e.js test/test-backgrounds.js",
    "test:engine": "node --test test/test-engine.js",
    "test:combat": "node --test test/test-combat.js",
    "test:e2e": "node --test test/test-e2e.js",
    "test:backgrounds": "node --test test/test-backgrounds.js"
  },
  "keywords": [
    "game",
    "arcade",
    "canvas",
    "html5-game",
    "pixel-art",
    "rotmg",
    "bleach",
    "tensa-zangetsu",
    "web-audio-api",
    "zero-dependencies"
  ],
  "author": "Antigravity & Developer",
  "license": "MIT"
}
